generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Tier 1 = Bad, Tier 2 = Badder, Tier 3 = Ugly (see scoring in src/lib/scoring.ts)
model Chemical {
  id           String   @id @default(cuid())
  name         String
  aliases      String[] @default([])
  severityTier Int      @map("severity_tier")
  category     String?

  healthEffect         String? @map("health_effect")
  bannedInCountries    String? @map("banned_in_countries")
  commonSubstituteNote String? @map("common_substitute_note")
  sourceNote           String? @map("source_note")

  // Extra fields carried over from the seed spreadsheet (not in the original spec,
  // kept per request instead of being dropped on import).
  foundIn        String? @map("found_in")
  exampleBrands  String? @map("example_brands")
  timeToManifest String? @map("time_to_manifest")

  // False for broad "concern category" rows (e.g. "Excessive Salt") that aren't a
  // literal label term -- excluded from automatic ingredient matching so they don't
  // flag nearly every product. Still visible/editable in admin as informational.
  matchable Boolean @default(true)

  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated")

  @@map("chemicals")
}

// Gap-finder agent output: an ingredient the scoring engine couldn't match to
// any existing Chemical gets researched by Claude and queued here for admin
// review. Never written directly into the live `chemicals` table.
model SuggestedChemical {
  id                   String   @id @default(cuid())
  name                 String
  proposedTier         Int      @map("proposed_tier")
  proposedCategory     String?  @map("proposed_category")
  proposedHealthEffect String?  @map("proposed_health_effect")
  sourceIngredientText String   @map("source_ingredient_text")
  reasoning            String?
  createdAt            DateTime @default(now()) @map("created_at")

  // Set when a name-similarity check found an existing chemical (or another
  // pending suggestion) that this might just be a re-worded duplicate of --
  // e.g. "Caramel Color" vs. an existing "Caramel Coloring III/IV". Informational
  // only, doesn't block approval; the id is denormalized as text (not a real FK)
  // since the target could be a Chemical or another SuggestedChemical, and either
  // could be deleted later without invalidating this note.
  possibleDuplicateOfName String? @map("possible_duplicate_of_name")
  possibleDuplicateNote   String? @map("possible_duplicate_note")

  @@map("suggested_chemicals")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  brand          String?
  country        String?
  category       String? // Open Food Facts category tag used for alternative lookups (Phase 2)
  ingredientList String   @map("ingredient_list")
  score          Int
  verdict        String
  lastChecked    DateTime @default(now()) @updatedAt @map("last_checked")

  // Chemical ids flagged for this scan (Phase 5 dashboard: enables
  // `SELECT unnest(flagged_chemical_ids) ...` aggregation without a join table).
  flaggedChemicalIds String[] @default([]) @map("flagged_chemical_ids")

  @@map("products")
}

// Anonymous usage analytics -- session_id is a random UUID from a browser
// cookie, never tied to a login/name/email. No tracking happens until the
// user has acknowledged the notice in src/components/AnalyticsNotice.tsx.
model Event {
  id             String   @id @default(cuid())
  sessionId      String   @map("session_id")
  timestamp      DateTime @default(now())
  productScanned String?  @map("product_scanned") // product name, or a SHA-256 hash of the ingredient list if unnamed
  verdictShown   String?  @map("verdict_shown")
  action         String // "viewed" | "clicked_alternative" | "dismissed"
  country        String? // self-selected from the checker's country dropdown, never GPS

  @@map("events")
}
