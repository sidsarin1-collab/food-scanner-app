# Postgres connection string, e.g. postgresql://user:password@localhost:5432/food_scanner
DATABASE_URL=

# Shared password for the /admin route (v1: single shared password, no user accounts)
ADMIN_PASSWORD=

# Anthropic API key -- used server-side only (photo-based ingredient scanning). Never exposed to the browser.
ANTHROPIC_API_KEY=

# Optional. Set to "false" to stop the paid gap-finder lookups on ingredient scans (unset = on).
GAP_FINDER_ENABLED=

# Optional. Max Claude requests the gap-finder may make per UTC day (default 50).
GAP_FINDER_DAILY_CAP=
